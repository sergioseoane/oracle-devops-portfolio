all:
  children:
    k3s_nodes:
      hosts:
        control-plane:
          ansible_host: 100.XX.XX.XX   # IP de Tailscale del nodo control-plane
        worker:
          ansible_host: 100.XX.XX.XX   # IP de Tailscale del nodo worker
      vars:
        ansible_user: ubuntu
        ansible_ssh_private_key_file: ~/.ssh/oracle_devops
        ansible_python_interpreter: /usr/bin/python3.10
